<Window x:Class="NoirvantaClipboard.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Noirvanta Clipboard" Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e"
        Foreground="#e0e0e0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Background="#252526" Padding="16">
            <TextBlock Text="NOIRVANTA CLIPBOARD" FontSize="16" FontWeight="Bold" Foreground="#00d4ff"/>
            <TextBlock Text="Ctrl+C to copy • Ctrl+Shift+V to select • Enter to paste" FontSize="12" Foreground="#888888" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Clipboard entries list -->
        <ListBox Grid.Row="1" x:Name="ClipboardListBox" Background="#1e1e1e" 
                 Foreground="#e0e0e0" BorderThickness="0"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="0,0,0,1" BorderBrush="#333333" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Content, StringFormat='{}Content: {0}'}"
                                           TextWrapping="Wrap" Foreground="#e0e0e0" FontSize="12"/>
                                <TextBlock Text="{Binding CreatedAt, StringFormat='{}Copied: {0:g}'}"
                                           Foreground="#888888" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button Content="📌" Tag="{Binding Id}" Click="PinButton_Click"
                                        Background="Transparent" Foreground="#00d4ff" 
                                        Padding="8" Margin="0,0,4,0"/>
                                <Button Content="🗑" Tag="{Binding Id}" Click="DeleteButton_Click"
                                        Background="Transparent" Foreground="#ff6b6b" 
                                        Padding="8"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Background="#252526" Padding="16" Orientation="Horizontal">
            <TextBlock Text="Status: Ready" x:Name="StatusText" Foreground="#00d4ff" FontSize="12"/>
            <Button Content="Clear History" Click="ClearButton_Click" 
                    Background="#333333" Foreground="#e0e0e0" Padding="8,4" Margin="0,0,0,0" HorizontalAlignment="Right"/>
        </StackPanel>
    </Grid>
</Window>