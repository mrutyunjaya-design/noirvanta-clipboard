<Window x:Class="NoirvantaClipboard.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Noirvanta Clipboard" Height="650" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#0d0d0d"
        Foreground="#e0e0e0"
        WindowStyle="ToolWindow"
        Topmost="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1f1f1f"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2a2a2a"/>
                            <Setter Property="BorderBrush" Value="#00d4ff"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#00d4ff"/>
                            <Setter Property="Foreground" Value="#0d0d0d"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1f1f1f"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="#00d4ff"/>
                            <Setter Property="Background" Value="#252526"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style x:Key="ClipboardEntryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1a1a1a"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="#00d4ff"/>
                            <Setter TargetName="Border" Property="BorderThickness" Value="2,0,0,1"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#1e3a4a"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="#00d4ff"/>
                            <Setter TargetName="Border" Property="BorderThickness" Value="3,0,0,1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Gradient -->
        <Grid Grid.Row="0" Background="#0a0a0a" Padding="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="NOIRVANTA CLIPBOARD" FontSize="18" FontWeight="Bold" Foreground="#00d4ff" LetterSpacing="1"/>
                <TextBlock Text="High-performance clipboard manager" FontSize="11" Foreground="#888888" Margin="0,4,0,0" Opacity="0.8"/>
            </StackPanel>

            <Button Grid.Column="1" Content="✕" Background="Transparent" Foreground="#888888" 
                    FontSize="14" Padding="8" Click="MinimizeButton_Click" Cursor="Hand"
                    BorderThickness="0"/>
        </Grid>

        <!-- Keyboard Shortcuts Info -->
        <Border Grid.Row="1" Background="#151515" BorderThickness="0,1,0,0" BorderBrush="#222222" Padding="20">
            <TextBlock Text="🎮 Ctrl+Shift+V: Show  •  ↑↓: Navigate  •  Enter: Paste  •  Delete: Remove  •  Ctrl+L: Focus Search  •  Esc: Hide" 
                       FontSize="11" Foreground="#666666" TextWrapping="Wrap"/>
        </Border>

        <!-- Search Bar and List Container -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search Input -->
            <Border Grid.Row="0" Background="#151515" Padding="16" BorderThickness="0,0,0,1" BorderBrush="#222222">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" x:Name="SearchTextBox" 
                             Text="" Foreground="#e0e0e0"
                             Style="{StaticResource SearchTextBoxStyle}"
                             KeyUp="SearchTextBox_KeyUp"
                             TextChanged="SearchTextBox_TextChanged"
                             ToolTip="Search clipboard history (Ctrl+L)"/>

                    <TextBlock Grid.Column="0" Text="🔍" Margin="12,0,0,0" 
                              VerticalAlignment="Center" Foreground="#666666" FontSize="14"
                              IsHitTestVisible="False"/>

                    <TextBlock Grid.Column="1" x:Name="ResultCountText" 
                              Foreground="#666666" FontSize="11" VerticalAlignment="Center" Margin="12,0"/>
                </Grid>
            </Border>

            <!-- Clipboard entries list -->
            <ListBox Grid.Row="1" x:Name="ClipboardListBox" Background="#0d0d0d" 
                     Foreground="#e0e0e0" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ItemContainerStyle="{StaticResource ClipboardEntryItemStyle}"
                     KeyDown="ClipboardListBox_KeyDown"
                     SelectionMode="Single">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16" MinHeight="85">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Content Section -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                    <!-- Type Badge & Pin Status -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Background="#1f3a4a" Padding="6,3" CornerRadius="3" Margin="0,0,6,0">
                                            <TextBlock Text="📋 TEXT" FontSize="9" Foreground="#00d4ff" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="📌 PINNED" FontSize="9" 
                                                  Foreground="#ffd700" FontWeight="Bold"
                                                  Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisConverter}}"/>
                                    </StackPanel>

                                    <!-- Content Preview -->
                                    <TextBlock Text="{Binding Content}" 
                                              TextWrapping="Wrap" Foreground="#e0e0e0" FontSize="12"
                                              MaxHeight="40" TextTrimming="CharacterEllipsis"
                                              LineHeight="16"/>

                                    <!-- Metadata -->
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='🕐 {0:MMM dd, HH:mm:ss}'}"
                                                  Foreground="#888888" FontSize="10"/>
                                        <TextBlock Text=" • " Foreground="#444444" Margin="6,0"/>
                                        <TextBlock Text="{Binding Content.Length, StringFormat='📝 {0} chars'}" Foreground="#666666" FontSize="10"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top" Margin="12,0,0,0" Spacing="6">
                                    <Button Content="📋" Tag="{Binding Id}" Click="CopyButton_Click"
                                           Background="#1a3a4a" Foreground="#00d4ff" Padding="8,4"
                                           FontSize="11" Style="{StaticResource RoundedButtonStyle}"
                                           ToolTip="Paste this entry"/>
                                    <Button Content="📌" Tag="{Binding Id}" Click="PinButton_Click"
                                           Background="#1f1f1f" Foreground="#ffd700" Padding="6,4"
                                           FontSize="11" Style="{StaticResource RoundedButtonStyle}"
                                           ToolTip="Pin this entry"/>
                                    <Button Content="🗑" Tag="{Binding Id}" Click="DeleteButton_Click"
                                           Background="#3a1a1a" Foreground="#ff6b6b" Padding="6,4"
                                           FontSize="11" Style="{StaticResource RoundedButtonStyle}"
                                           ToolTip="Delete this entry"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Footer with Status -->
        <Border Grid.Row="3" Background="#0a0a0a" BorderThickness="0,1,0,0" BorderBrush="#222222" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="StatusText" Foreground="#00d4ff" FontSize="11" VerticalAlignment="Center"/>
                
                <Button Grid.Column="1" Content="⚙ Settings" Click="SettingsButton_Click"
                       Style="{StaticResource RoundedButtonStyle}" Margin="0,0,8,0"/>
                
                <Button Grid.Column="2" Content="🗑 Clear All" Click="ClearButton_Click"
                       Background="#2a1a1a" Foreground="#ff6b6b" 
                       Style="{StaticResource RoundedButtonStyle}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
